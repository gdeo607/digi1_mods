{
 "elemod": 2,
 "id": "machine-pages",
 "version": "1.2",
 "title": "machine pages",
 "description": "Draws the SRC and LFO pages of the SRC machines that describe their own (core 3.0), and gives the render an event for machines that make or take a track's sound, so several machine mods combine. On its own, and for machines that do not describe a page, it changes nothing the unit does.",
 "category": "Framework",
 "author": "irpina",
 "license": "GPL-2.0-or-later",
